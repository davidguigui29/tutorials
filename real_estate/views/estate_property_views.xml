    <record id="estate_property_search" model="ir.ui.view">
        <field name="name">Property Search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Property Search">
                <field name="name"/>
                <field name="postcode" />
                <field name="expected_price" />
                <field name="bedrooms"/>
                <field name="living_area" />
                <field name="facades" />
                <field name="property_type_id"/>
                <field name="tags_ids"/>

                <separator/>

                <!-- Filter for Available Properties -->
                <filter string="Available Properties" name="filter_available_properties" 
                        domain="[('state', 'in', ['new', 'offer_received'])]"/>


                <!-- <filter string="Available Today" name="available_today" domain="[('date_availability', '=', context_today())]"/>
                <filter string="Future Dates" name="future_dates" domain="[('date_availability', '&gt;', context_today())]"/>
                <filter string="Past Dates" name="past_dates" domain="[('date_availability', '&lt;', context_today())]"/>
                <filter string="Available and Approved" name="available_approved" domain="['&amp;', ('date_availability', '=', context_today()), ('state', '=', 'approved')]"/> -->

                <group string="State Filters">  
                    <filter string="New" name="state_new" domain="[('state', '=', 'new')]"/>
                    <filter string="Offer Received" name="state_offer_received" domain="[('state', '=', 'offer_received')]"/>
                    <filter string="Offer Accepted" name="state_offer_accepted" domain="[('state', '=', 'offer_accepted')]"/>
                    <filter string="Sold" name="state_sold" domain="[('state', '=', 'sold')]"/>
                    <filter string="Cancelled" name="state_cancelled" domain="[('state', '=', 'cancelled')]"/>
                </group>

                <!-- <filter string="Available" name="active" domain="[('active', '=', False)]"/> -->

                <!-- Filter for New and Cancelled (Logical AND Example) -->
                <filter string="New and Cancelled Postcode 123" name="filter_new_and_cancelled_postcode" 
                        domain="['&amp;', ('state', '=', 'new'), ('postcode', 'ilike', '123')]"/>

                <group expand="1" string="Group By">
                    <filter string="Postcode" name="group_by_postcode" context="{'group_by': 'postcode'}"/>
                </group>
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="estate_property_list">
        <field name="name">Properties</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Property list">
                <field name="name" />
                <field name="property_type_id"/>
                <field name="postcode" />
                <field name="bedrooms" />
                <field name="living_area" />
                <field name="expected_price" />
                <field name="selling_price" />
                <field name="date_availability" />
            </list>
        </field>
    </record>


    <record model="ir.ui.view" id="estate_property_form">
        <field name="name">Properties</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Property form">
                <sheet>
                    <h1>
                        <field name="name" placeholder="Property Name" />
                    </h1>
                    <group>
                        
                        <field name="tags_ids" widget="many2many_tags" placeholder="Select tag(s)"/>
                       
                        <group>
                            <field name="property_type_id"/>
                            <field name="postcode" />
                            <field name="date_availability" />
                        </group>
                        <group>
                            <field name="expected_price" />
                            <field name="selling_price" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description" />
                                <field name="bedrooms" />
                                <field name="living_area" />
                                <field name="facades" />
                                <field name="garage" />
                                <field name="garden_area" />
                                <field name="garden_orientation" />
                                <field name="total_area" />
                            </group>
                        </page>

                        
                        <page string="Offers">
                            <!-- Wrap the one2many field in a DIV with float:right -->
                            <div style="float: right;">
                                <field name="offer_ids">
                                    <list class="my_custom_tree">
                                        <field name="price" />
                                        <field name="partner_id" />
                                        <field name="status" />
                                    </list>
                                    <form string="Offer Details">
                                        <sheet>
                                            <!-- Wrap the group in a div with flex centering -->
                                            <!-- <div style="display: flex; justify-content: center; align-items: center;"> -->
                                                <group>
                                                    <field name="price" />
                                                    <field name="partner_id" />
                                                    <field name="status" />
                                                </group>
                                            <!-- </div> -->
                                        </sheet>
                                    </form>
                                </field>
                            </div>
                        </page>



                        <page string="Other Info">
                            <group>
                                <field name="seller"/>
                                <field name="buyer"/>
                            </group>

                        </page>
                    </notebook>
                   
                </sheet>
            </form>
        </field>
    </record>

</odoo>